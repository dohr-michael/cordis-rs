package cordis:plugin@0.1.0;

/// Host-owned diagnostics available to every Cordis component generation.
///
/// The host assigns the Runtime logger channel, so a guest cannot impersonate
/// another Fiber. This is evidence for the lifecycle fixture, not a Service
/// or general Context capability.
interface diagnostics {
  /// Semantic severity supported by Cordis's runtime logger.
  enum level {
    debug,
    info,
    warn,
    error,
  }

  /// Emit one guest diagnostic through the owning Fiber's logger channel.
  emit: async func(level: level, message: string);
}

/// The guest-controlled part of one Cordis apply generation.
///
/// One component instance represents one apply generation. Restart and
/// same-Fiber update close the current generation and create a new component
/// instance; era replacement also creates a new Fiber. No guest-defined
/// resource is needed to represent either identity.
interface lifecycle {
  /// A guest-reported lifecycle failure.
  record lifecycle-error {
    message: string,
  }

  /// Start this component instance's apply generation.
  ///
  /// The host calls this once after instantiation. A returned error prevents
  /// the generation from becoming active. The host then calls `dispose` once
  /// to release the instance; guests must therefore tolerate disposal before
  /// successful activation.
  activate: async func() -> result<_, lifecycle-error>;

  /// Finish guest-owned cleanup for this component instance.
  ///
  /// The operation is asynchronous because cleanup may await guest-owned
  /// work. It is idempotent: repeated calls must succeed after the first
  /// completed disposal. A returned error or a trap is diagnostic only; the
  /// host still closes the generation and drops the component instance.
  dispose: async func() -> result<_, lifecycle-error>;
}

/// The deliberately narrow Component Model spike contract.
world cordis-plugin {
  import diagnostics;
  export lifecycle;
}
