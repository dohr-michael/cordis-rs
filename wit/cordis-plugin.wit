package cordis:plugin@0.1.0;

/// Host-owned diagnostics available to every Cordis component generation.
///
/// This is a foundation capability, not a Cordis Service: it neither creates
/// a dependency edge nor grants access to another Fiber's Context. The host
/// assigns the Runtime logger channel, so a guest cannot impersonate one.
interface diagnostics {
  /// Semantic severity supported by Cordis's runtime logger.
  enum level {
    debug,
    info,
    warn,
    error,
  }

  /// Emit one guest diagnostic through the owning Fiber's logger channel.
  emit: async func(level: level, message: string);
}

/// Immutable input selected by the host for one component generation.
///
/// This is not a generic Service lookup. The bytes are supplied before guest
/// activation and are replaced only when Cordis creates a fresh generation.
interface configuration {
  /// Read this generation's opaque configuration payload.
  get: async func() -> list<u8>;
}

/// Static declaration for one Cordis Component implementation.
///
/// This is descriptive metadata, not a general Service locator. The host reads
/// it before lifecycle activation; later ABI revisions may map declared
/// standards to Cordis dependency edges.
interface manifest {
  /// A standard host capability consumed by the guest.
  enum standard-capability {
    configuration,
    diagnostics,
  }

  /// Stable guest-facing identity and declared standard capabilities.
  record descriptor {
    name: string,
    standard-capabilities: list<standard-capability>,
  }

  /// Describe this Component without performing lifecycle work.
  describe: async func() -> descriptor;
}

/// The guest-controlled part of one Cordis apply generation.
///
/// One component instance represents one apply generation. Restart and
/// same-Fiber update close the current generation and create a new component
/// instance; era replacement also creates a new Fiber. No guest-defined
/// resource is needed to represent either identity.
interface lifecycle {
  /// A guest-reported lifecycle failure.
  record lifecycle-error {
    message: string,
  }

  /// Start this component instance's apply generation.
  ///
  /// The host calls this once after instantiation. A returned error prevents
  /// the generation from becoming active and the host drops the instance.
  activate: async func() -> result<_, lifecycle-error>;

  /// Finish guest-owned cleanup for this component instance.
  ///
  /// The operation is asynchronous because cleanup may await guest-owned
  /// work. It is idempotent: repeated calls must succeed after the first
  /// completed disposal. A returned error is diagnostic only; the host still
  /// closes the generation and drops the component instance.
  dispose: async func() -> result<_, lifecycle-error>;
}

/// The minimal Cordis component contract.
///
/// The host owns the imported diagnostics capability and binds it to the
/// current Fiber generation. Context, Events, Services, and configuration are
/// intentionally not yet part of the ABI.
world cordis-plugin {
  import configuration;
  import diagnostics;
  export lifecycle;
  export manifest;
}
