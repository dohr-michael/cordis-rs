package cordis:plugin@0.1.0;

/// The guest-controlled part of a Cordis Fiber's lifecycle.
///
/// One component instance represents one Fiber. The host creates a new
/// component instance for an era replacement; no guest-defined resource is
/// needed to represent that identity.
interface lifecycle {
  /// Finish guest-owned cleanup for this component instance.
  ///
  /// The operation is asynchronous because cleanup may await guest-owned
  /// work. It is idempotent: repeated calls must succeed after the first
  /// completed disposal. A returned error is diagnostic only; the host still
  /// terminates its Fiber and drops the component instance.
  dispose: async func() -> result<_, string>;
}

/// The minimal Cordis component contract.
///
/// This deliberately has no host imports and no activation operation yet.
/// It establishes the teardown boundary before Context, Events, Services, or
/// configuration become part of the ABI.
world cordis-plugin {
  export lifecycle;
}
